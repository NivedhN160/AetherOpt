# ==============================================================================
# AetherOpt Environment Configuration
# ==============================================================================

# 1. Application Environment
# 'development' enables auto-reload and verbose logging. Use 'production' for deployments.
AETHEROPT_ENV=development

# 2. Authentication API Key
# The frontend MUST send this key in the `X-API-Key` header.
API_KEY=secret_key

# 3. Database URL
# SQLite is the default and sufficient for most use cases due to background queueing.
DATABASE_URL=sqlite:///./aetheropt.db